+  it 'streams server time over sse' do
+    next if server.webrick? or server.trinidad?
+
+    response = nil
+    chunk = nil
+
+    assert_raises EOFError do
+      Net::HTTP.start '127.0.0.1', server.port do |http|
+        request = Net::HTTP::Get.new '/logs/stream'
