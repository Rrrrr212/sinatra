--- /dev/null
+++ b/app.rb
@@ -0,0 +1,51 @@
+require 'sinatra'
+
+# 现有基础的 GET/POST 请求处理
+get '/' do
+  "Welcome to the Sinatra App"
+end
+
+post '/data' do
+  "Data received"
+end
+
+# 新增文件上传功能
+post '/upload' do
+  unless params[:file] && params[:file][:tempfile] && params[:file][:filename]
+    halt 400, "No file provided"
+  end
+
+  tempfile = params[:file][:tempfile]
+  filename = File.basename(params[:file][:filename])
+
+  # 校验文件大小不超过 10MB
+  if tempfile.size > 10 * 1024 * 1024
+    halt 400, "File size exceeds 10MB limit."
+  end
+
+  # 上传目录为仓库根目录下的 ./uploads
+  uploads_dir = File.join(File.dirname(__FILE__), 'uploads')
+  Dir.mkdir(uploads_dir) unless Dir.exist?(uploads_dir)
+
+  # 保存文件
+  target_path = File.join(uploads_dir, filename)
+  File.open(target_path, 'wb') do |f|
+    f.write(tempfile.read)
+  end
+
+  "File uploaded successfully"
+end
+
+# 新增文件下载功能
+get '/download/:filename' do |filename|
+  safe_filename = File.basename(filename)
+  file_path = File.join(File.dirname(__FILE__), 'uploads', safe_filename)
+  
+  if File.exist?(file_path)
+    # 使用 send_file 提供下载，并设置 attachment 使浏览器识别为下载
+    attachment safe_filename
+    send_file file_path
+  else
+    halt 404, "File not found"
+  end
+end
